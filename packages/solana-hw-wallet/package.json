{
  "name": "@marinade.finance/solana-hw-wallet",
  "version": "1.0.0",
  "description": "Solana hardware wallet (Ledger, Trezor) signing for Node.js CLI tools",
  "license": "ISC",
  "author": "Marinade.Finance",
  "repository": {
    "type": "git",
    "url": "git@github.com:marinade-finance/ledger-utils.git"
  },
  "keywords": [
    "solana",
    "marinade.finance",
    "blockchain",
    "ledger",
    "trezor",
    "hardware-wallet",
    "wallet",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/",
    "!dist/__tests__",
    "!dist/test-utils",
    "!dist/emulator",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "pnpm jest --config ../../jest.config.js --testPathPatterns=\"$(pwd)\"",
    "test:emulator": "tsc --build && node --test dist/emulator/trezor.e2e.js"
  },
  "dependencies": {
    "@marinade.finance/web3js-kit": "^5.12.1",
    "@solana/accounts": "^8.6.0",
    "@solana/addresses": "^8.6.0",
    "@solana/codecs": "^8.6.0",
    "@solana/keys": "^8.6.0",
    "@solana/offchain-messages": "^8.6.0",
    "@solana/rpc": "^8.6.0",
    "@solana/rpc-types": "^8.6.0",
    "@solana/signers": "^8.6.0",
    "@solana/transactions": "^8.6.0"
  },
  "devDependencies": {
    "@ledgerhq/hw-app-solana": "^7.12.0",
    "@ledgerhq/hw-transport": "^6.36.1",
    "@ledgerhq/hw-transport-node-hid-noevents": "^6.36.0",
    "@marinade.finance/ts-common": "^5.12.0",
    "@solana/transaction-messages": "^8.6.0",
    "@solana/web3.js": "^1.99.0",
    "@trezor/connect": "^10.0.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@ledgerhq/hw-app-solana": "^7.12.0",
    "@ledgerhq/hw-transport-node-hid-noevents": "^6.36.0",
    "@marinade.finance/ts-common": "^5.7.0",
    "@solana/web3.js": "^1.99.0",
    "@trezor/connect": "^10.0.1"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-app-solana": {
      "optional": true
    },
    "@ledgerhq/hw-transport-node-hid-noevents": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@trezor/connect": {
      "optional": true
    }
  }
}
