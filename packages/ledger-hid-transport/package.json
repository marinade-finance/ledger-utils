{
  "name": "@marinade.finance/ledger-hid-transport",
  "version": "1.0.0",
  "description": "Ledger USB HID transport for Node.js on node-hid 3, a @ledgerhq/hw-transport Transport",
  "license": "(ISC AND Apache-2.0)",
  "author": "Marinade.Finance",
  "repository": {
    "type": "git",
    "url": "git@github.com:marinade-finance/ledger-utils.git"
  },
  "keywords": [
    "ledger",
    "hid",
    "usb",
    "transport",
    "hardware-wallet",
    "node-hid"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
